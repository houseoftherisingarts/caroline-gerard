rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin : liste blanche par UID (comptes réels), avec repli sur les
    // courriels Vexel VÉRIFIÉS (connexion Google). Le motif @admin.local n'est
    // volontairement PAS reconnu ici : n'importe qui peut créer un compte avec
    // ce suffixe via l'inscription membre.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          'qieZGM8Vnie92DblUtpvi710q3F3',   // Caroline — Espace Auteure
          'lcfLrSZjcUTxwAgMe8tkCivdXQj1'    // Alex — Vexel
        ]
        || (request.auth.token.email in ['alex@lesalondesinconnus.com', 'krystine@inspiratanature.com']
            && request.auth.token.email_verified == true)
      );
    }

    // La finition du collant Vexel, une par formule d'abonnement (voir
    // _vexel-base/docs/COLLANT-REGLES.md). Caroline Gérard porte Base.
    function finitionsDe(formule) {
      return formule == 'signature'
        ? ['noir', 'blanc', 'rouge', 'bleu', 'vert', 'violet', 'bronze', 'argent', 'or', 'saphir', 'irise', 'arc-en-ciel']
        : formule == 'hybride'
          ? ['noir', 'blanc', 'rouge', 'bleu', 'vert', 'violet', 'bronze', 'argent', 'or', 'saphir']
          : ['noir', 'blanc', 'rouge', 'bleu', 'vert', 'violet', 'bronze'];
    }
    function collantOk(formule) {
      return !('collant' in request.resource.data)
        || request.resource.data.collant in finitionsDe(formule);
    }

    function keysOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Bornes d'un rendez-vous : mêmes règles que l'agenda de Xena Horizon.
    function rdvValide(data) {
      return data.nom is string && data.nom.size() < 120
             && data.courriel is string && data.courriel.size() < 200
             && data.debut is timestamp && data.fin is timestamp
             && data.fin > data.debut
             && data.duree is number && data.duree >= 15 && data.duree <= 240
             && data.fin.toMillis() - data.debut.toMillis() == data.duree * 60000
             && data.salle is string && data.salle.size() < 80
             && (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    // ── Contenu public du site : lecture libre, écriture admin ──
    match /books/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /posts/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /conferences/{id} { allow read: if true; allow write: if isAdmin(); }
    match /interviews/{id}  { allow read: if true; allow write: if isAdmin(); }
    // Les réglages de facturation et de finances portent l'identité légale et les numéros de taxes :
    // seuls les administrateurs les lisent. Tous les autres réglages restent publics.
    match /settings/{id}    {
      allow read: if isAdmin() || !(id in ['facturation', 'compta', 'plan_comptable', 'fiscal']);
      allow write: if isAdmin() && (id != 'vexel' || collantOk('base'));
    }

    // Témoignages : le public peut en soumettre un (jamais publié d'office)
    match /testimonials/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        keysOnly(['id', 'quote', 'signature', 'page', 'type', 'isPublished', 'createdAt', 'email'])
        && request.resource.data.type == 'client'
        && request.resource.data.isPublished == false
        && request.resource.data.quote is string && request.resource.data.quote.size() <= 2000
        && request.resource.data.signature is string && request.resource.data.signature.size() <= 200
      );
      allow update, delete: if isAdmin();
    }

    // Codes promo : lecture directe par code à la caisse, jamais de liste publique
    match /promoCodes/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Formulaires publics : création contrainte, lecture admin seulement ──
    match /subscribers/{id} {
      allow create: if keysOnly(['id', 'email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('.+@.+[.].+');
      allow read, update, delete: if isAdmin();
    }

    // Expéditeurs signalés comme pourriel (lus par sendContactForm via l'Admin SDK)
    match /pourriel/{id} { allow read, write: if isAdmin(); }

    match /leads/{id} {
      allow create: if keysOnly(['id', 'source', 'name', 'email', 'message', 'date', 'isRead', 'archived', 'dateSouhaitee'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.message is string && request.resource.data.message.size() <= 10000
        && request.resource.data.isRead == false
        && (!('dateSouhaitee' in request.resource.data)
            || (request.resource.data.dateSouhaitee is string && request.resource.data.dateSouhaitee.size() <= 10));
      allow read, update, delete: if isAdmin();
    }

    // ── Agenda de rendez-vous (lib/rendezvous.ts) ──
    // settings/agenda (disponibilités de Caroline) est déjà couvert par settings/{id} ci-dessus.
    match /rendezvous/{rdvId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
                    || (isOwner(request.resource.data.uid)
                        && request.resource.data.statut == 'demande'
                        && request.resource.data.creePar == 'client'
                        && request.resource.data.debut > request.time
                        && rdvValide(request.resource.data)
                        && request.resource.data.keys().hasOnly(['uid', 'nom', 'courriel', 'debut', 'fin', 'duree', 'statut', 'salle', 'note', 'creePar', 'createdAt', 'updatedAt']));
      // La personne ne peut qu'annuler le sien; le reste appartient à Caroline.
      allow update: if isAdmin()
                    || (isOwner(resource.data.uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'updatedAt'])
                        && request.resource.data.statut == 'annule');
      allow delete: if isAdmin();
    }
    // Miroir sans donnée personnelle : les personnes connectées voient les créneaux déjà pris.
    match /occupations/{rdvId} {
      allow read: if request.auth != null;
      // Le miroir n'existe que pour un rendez-vous réel écrit dans le même lot, au nom de la
      // personne, aux mêmes heures : impossible de bloquer l'agenda avec une occupation fantôme.
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.debut is timestamp
                        && request.resource.data.fin is timestamp
                        && request.resource.data.fin > request.resource.data.debut
                        && request.resource.data.keys().hasOnly(['debut', 'fin'])
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.uid == request.auth.uid
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.debut == request.resource.data.debut
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.fin == request.resource.data.fin);
      allow delete: if isAdmin()
                    || (request.auth != null && get(/databases/$(database)/documents/rendezvous/$(rdvId)).data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /abandonedCheckouts/{id} {
      allow create, update: if keysOnly(['id', 'email', 'firstName', 'lastName', 'phone',
        'address', 'city', 'postalCode', 'cartItems', 'subtotal', 'startedAt']);
      allow read, delete: if isAdmin();
    }

    // ── Espace client ──
    match /members/{memberId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
    }

    match /communityMessages/{id} {
      allow create: if request.auth != null
        && (isAdmin() || request.resource.data.memberId == request.auth.uid);
      allow read: if isAdmin() || (request.auth != null && resource.data.memberId == request.auth.uid);
      allow update: if (isAdmin() || (request.auth != null && resource.data.memberId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── Commandes : créées uniquement par la Cloud Function (SDK admin) ──
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create, delete: if false;
    }

    // ── Outils internes de l'Espace Auteure ──
    match /emailLog/{id}             { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /kanban/{id}               { allow read, write: if isAdmin(); }
    match /invoices/{id}             { allow read, write: if isAdmin(); }
    match /clients/{id}              { allow read, write: if isAdmin(); }
    match /consignmentLocations/{id} { allow read, write: if isAdmin(); }
    match /consignmentMovements/{id} { allow read, write: if isAdmin(); }
    match /stockMovements/{id}       { allow read, write: if isAdmin(); }

    // --- module compta : début (_vexel-base/modules/compta, rules/firestore.rules.compta.txt) ---
    // Les devis, factures et notes de crédit (pages/AdminInvoices.tsx) : admin seulement.
    match /documents/{docId}       { allow read, write: if isAdmin(); }

    // Miroir public d'une facture publiée : lisible par jeton (assez long pour être imprévisible),
    // jamais listable, jamais écrit ailleurs que par Laurie (lib/factures.ts, publierFacture).
    // La collection documents (source, avec l'identité de la personne facturée) reste admin seulement.
    // Le miroir ne porte que ce que la page publique montre (lib/factures.ts, FacturePubliqueDoc) : pas de
    // note privée de paiement, pas de récurrence, pas de relance. payeLe vient du webhook Stripe; les
    // fonctions serveur (envoi des récurrences) écrivent avec l'Admin SDK et passent à côté de ces règles.
    match /factures_publiques/{jeton} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['documentId', 'numero', 'type', 'date', 'dueDate',
                        'clientName', 'clientEmail', 'items', 'totaux', 'statut', 'modalites', 'note', 'vendeur',
                        'lienPaiementStripe', 'publieLe', 'remise', 'paiements', 'credits', 'solde',
                        'factureNumero', 'piecesJointes', 'payeLe', 'paiementCarte']);
      allow delete: if isAdmin();
    }

    // Module comptable (lib/compta/) : grand livre et tiers, admin seulement. Les réglages
    // (settings/compta, settings/plan_comptable, settings/fiscal) restent couverts par /settings ci-dessus.
    match /transactions/{transactionId} { allow read, write: if isAdmin(); }
    match /tiers/{tierId}               { allow read, write: if isAdmin(); }
    // --- module compta : fin ---

    // trafic/{AAAA-MM-JJ} : écrit par recordVisit (SDK admin), lu par l'Espace Auteure seulement.
    match /trafic/{jour}             { allow read: if isAdmin(); allow write: if false; }

    // uniqueVisitors : réservé au SDK admin (recordVisit).
    // Toute collection absente de cette liste est refusée par défaut.
  }
}
