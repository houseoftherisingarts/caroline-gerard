rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Même liste blanche que firestore.rules : les téléversements viennent
    // uniquement de l'Espace Auteure (médiathèque, couvertures, blog...).
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          'qieZGM8Vnie92DblUtpvi710q3F3',   // Caroline — Espace Auteure
          'lcfLrSZjcUTxwAgMe8tkCivdXQj1'    // Alex — Vexel
        ]
        || (request.auth.token.email in ['alex@lesalondesinconnus.com', 'krystine@inspiratanature.com']
            && request.auth.token.email_verified == true)
      );
    }

    // --- module compta : début (_vexel-base/modules/compta, rules/storage.rules.compta.txt) ---
    // Pièces jointes des factures (components/admin/factures/PiecesJointes.tsx) : documents/{docId}/{nom},
    // un PDF ou une image de moins de 20 Mo. La personne facturée n'a que l'adresse à jeton (getDownloadURL)
    // recopiée dans le miroir factures_publiques quand Laurie coche « visible par le client ».
    match /documents/{file=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.size < 20 * 1024 * 1024
                            && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow delete: if isAdmin();
    }

    // Reçus du module comptable (lib/compta/, components/admin/finances/Recus.tsx) : admin seulement,
    // une image ou un PDF, 15 Mo.
    match /recus/{transactionId}/{file} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }
    // --- module compta : fin ---

    // Le reste du bucket est public en lecture (médiathèque, couvertures, blog). Les deux racines du module
    // Factures et Finances (documents/ et recus/) sont exclues ici, en lecture comme en écriture : les règles
    // se cumulent, et celles du module y sont plus strictes (admin seulement, type et taille du fichier).
    match /{allPaths=**} {
      allow read: if !(allPaths.matches('documents/.*') || allPaths.matches('recus/.*'));
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024
                   && !(allPaths.matches('documents/.*') || allPaths.matches('recus/.*'));
    }
  }
}
